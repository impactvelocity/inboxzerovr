{
 "duration": 116.509,
 "cues": {
  "unread": {
   "start": 1.0,
   "end": 3.71,
   "text": "Have you got 181 unread emails?"
  },
  "tried": {
   "start": 4.05,
   "end": 5.74,
   "text": "Tried filters, or reminders?"
  },
  "sword": {
   "start": 6.04,
   "end": 8.08,
   "text": "But have you tried a sword?"
  },
  "flame": {
   "start": 8.33,
   "end": 9.52,
   "text": "Or a flamethrower?"
  },
  "slash": {
   "start": 10.3,
   "end": 13.66,
   "text": "Slash, burn, and smash your way to Inbox Zero!"
  },
  "hack": {
   "start": 13.88,
   "end": 15.61,
   "text": "Built for the Meta Start Hackathon,"
  },
  "game": {
   "start": 15.71,
   "end": 17.53,
   "text": "it's a game to clear your inbox,"
  },
  "round": {
   "start": 17.67,
   "end": 18.79,
   "text": "one round at a time"
  },
  "howit": {
   "start": 19.71,
   "end": 20.6,
   "text": "Here's how it works"
  },
  "connect": {
   "start": 20.85,
   "end": 24.21,
   "text": "Connect your Gmail, and your latest unread emails become a game!"
  },
  "grab": {
   "start": 24.45,
   "end": 26.41,
   "text": "Grab an email with your left hand to read it,"
  },
  "throw": {
   "start": 26.63,
   "end": 27.61,
   "text": "throw it to keep it,"
  },
  "cut": {
   "start": 27.82,
   "end": 31.09,
   "text": "or take your right hand and cut it up into tiny little pieces"
  },
  "replies": {
   "start": 31.35,
   "end": 34.48,
   "text": "Every email you keep comes back with two short replies"
  },
  "hold": {
   "start": 34.71,
   "end": 36.0,
   "text": "Hold it up to the one you like,"
  },
  "pull": {
   "start": 36.22,
   "end": 37.68,
   "text": "pull it close to say your own,"
  },
  "later": {
   "start": 37.83,
   "end": 40.08,
   "text": "or throw it away and leave it for tomorrow"
  },
  "minutes": {
   "start": 40.96,
   "end": 43.82,
   "text": "Just a few minutes a day to clear your email anxiety,"
  },
  "monitor": {
   "start": 43.95,
   "end": 46.98,
   "text": "and you finally get to smash your monitor with your keyboard!"
  },
  "castle": {
   "start": 50.73,
   "end": 52.91,
   "text": "Defend your castle from haunted mail!"
  },
  "lab": {
   "start": 56.61,
   "end": 58.81,
   "text": "Disinfect toxic spam in the lab!"
  },
  "inferno": {
   "start": 62.55,
   "end": 65.03,
   "text": "Torch your inbox in the Inferno mail room!"
  },
  "kyoto": {
   "start": 68.77,
   "end": 71.52,
   "text": "Slice your worries away in a Kyoto zen garden!"
  },
  "axe": {
   "start": 75.23,
   "end": 77.1,
   "text": "Split your backlog with an axe!"
  },
  "or": {
   "start": 80.72,
   "end": 81.09,
   "text": "Or..."
  },
  "space": {
   "start": 81.27,
   "end": 83.98,
   "text": "slice through deep space with a laser sword!"
  },
  "iwsdk": {
   "start": 87.73,
   "end": 90.21,
   "text": "It's built with Meta's Immersive Web SDK,"
  },
  "browser": {
   "start": 90.34,
   "end": 91.82,
   "text": "so it runs right in the browser,"
  },
  "nodl": {
   "start": 91.9,
   "end": 93.18,
   "text": "with nothing to download"
  },
  "chair": {
   "start": 93.4,
   "end": 95.09,
   "text": "It's made to play from your chair"
  },
  "come": {
   "start": 95.27,
   "end": 98.13,
   "text": "Emails come to you, and your weapons do the stretching!"
  },
  "really": {
   "start": 98.36,
   "end": 100.53,
   "text": "And it really does clear your inbox"
  },
  "tags": {
   "start": 100.72,
   "end": 103.94,
   "text": "AI tags each email and boils it down to a quick summary"
  },
  "forgets": {
   "start": 104.17,
   "end": 106.37,
   "text": "The AI reads your mail, then forgets it,"
  },
  "saved": {
   "start": 106.56,
   "end": 107.61,
   "text": "nothing is saved"
  },
  "try": {
   "start": 108.48,
   "end": 111.35,
   "text": "Try it yourself at InboxZeroVR.com"
  },
  "seven": {
   "start": 111.46,
   "end": 113.6,
   "text": "and play the demo in all seven levels"
  },
  "hero": {
   "start": 113.74,
   "end": 116.23,
   "text": "Become a hero with inbox zero!"
  }
