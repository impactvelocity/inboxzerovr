{
 "duration": 134.38,
 "cues": {
  "unread": {
   "start": 0.4,
   "end": 3.11,
   "text": "Have you got 181 unread emails?"
  },
  "tried": {
   "start": 3.45,
   "end": 5.14,
   "text": "Tried filters, or reminders?"
  },
  "sword": {
   "start": 5.44,
   "end": 7.48,
   "text": "But have you tried a sword?"
  },
  "flame": {
   "start": 7.73,
   "end": 8.92,
   "text": "Or a flamethrower?"
  },
  "slash": {
   "start": 9.7,
   "end": 13.06,
   "text": "Slash, burn, and smash your way to Inbox Zero!"
  },
  "hack": {
   "start": 13.28,
   "end": 15.01,
   "text": "Built for the Meta Start Hackathon,"
  },
  "game": {
   "start": 15.11,
   "end": 16.93,
   "text": "it's a game to clear your inbox,"
  },
  "round": {
   "start": 17.07,
   "end": 18.19,
   "text": "one round at a time"
  },
  "howit": {
   "start": 19.09,
   "end": 20.06,
   "text": "Here's how it works"
  },
  "connect": {
   "start": 20.34,
   "end": 22.4,
   "text": "Connect our MCP to your Muse agent"
  },
  "ask": {
   "start": 22.52,
   "end": 23.86,
   "text": "and ask it to set up a game!"
  },
  "reads": {
   "start": 24.91,
   "end": 27.48,
   "text": "It reads your newest unread emails"
  },
  "link": {
   "start": 27.55,
   "end": 29.73,
   "text": "and makes you a special link that opens right on your Meta Quest!"
  },
  "pick": {
   "start": 30.96,
   "end": 31.56,
   "text": "Pick your level,"
  },
  "play": {
   "start": 31.72,
   "end": 32.45,
   "text": "and hit play!"
  },
  "grab": {
   "start": 33.26,
   "end": 35.28,
   "text": "Grab an email with your left hand to read it,"
  },
  "throw": {
   "start": 35.49,
   "end": 36.51,
   "text": "throw it to keep it,"
  },
  "cut": {
   "start": 36.7,
   "end": 39.95,
   "text": "or take your right hand and cut it up into tiny little pieces"
  },
  "replies": {
   "start": 40.61,
   "end": 44.02,
   "text": "Every email you keep comes back with two short replies from your agent"
  },
  "hold": {
   "start": 44.39,
   "end": 45.56,
   "text": "Hold it up to the one you like,"
  },
  "pull": {
   "start": 45.81,
   "end": 47.23,
   "text": "pull it close to say your own,"
  },
  "later": {
   "start": 47.45,
   "end": 49.52,
   "text": "or throw it away and leave it for tomorrow"
  },
  "minutes": {
   "start": 50.44,
   "end": 53.3,
   "text": "Just a few minutes a day to clear your email anxiety,"
  },
  "monitor": {
   "start": 53.43,
   "end": 56.46,
   "text": "and you finally get to smash your monitor with your keyboard!"
  },
  "castle": {
   "start": 60.21,
   "end": 62.39,
   "text": "Defend your castle from haunted mail!"
  },
  "lab": {
   "start": 66.09,
   "end": 68.29,
   "text": "Disinfect toxic spam in the lab!"
  },
  "inferno": {
   "start": 72.03,
   "end": 74.51,
   "text": "Torch your inbox in the Inferno mail room!"
  },
  "kyoto": {
   "start": 78.25,
   "end": 81.0,
   "text": "Slice your worries away in a Kyoto zen garden!"
  },
  "axe": {
   "start": 84.71,
   "end": 86.58,
   "text": "Split your backlog with an axe!"
  },
  "or": {
   "start": 90.2,
   "end": 90.57,
   "text": "Or..."
  },
  "space": {
   "start": 90.75,
   "end": 93.46,
   "text": "slice through deep space with a laser sword!"
  },
  "iwsdk": {
   "start": 97.14,
   "end": 99.69,
   "text": "It's built with Meta's Immersive Web SDK,"
  },
  "browser": {
   "start": 99.75,
   "end": 101.25,
   "text": "so it runs right in the browser,"
  },
  "nodl": {
   "start": 101.33,
   "end": 102.57,
   "text": "with nothing to download!"
  },
  "chair": {
   "start": 102.86,
   "end": 104.35,
   "text": "It's made to play from your chair"
  },
  "come": {
   "start": 104.66,
   "end": 107.33,
   "text": "Emails come to you, and your weapons do the stretching!"
  },
  "really": {
   "start": 111.18,
   "end": 113.26,
   "text": "And it really does clear your inbox"
  },
  "archives": {
   "start": 113.91,
   "end": 115.38,
   "text": "Your agent archives what you cut"
  },
  "sends": {
   "start": 115.46,
   "end": 116.53,
   "text": "and sends your replies,"
  },
  "okay": {
   "start": 116.62,
   "end": 117.65,
   "text": "after you say okay"
  },
  "never": {
   "start": 118.94,
   "end": 120.74,
   "text": "The game never touches your inbox,"
  },
  "deleted": {
   "start": 120.86,
   "end": 122.78,
   "text": "and each round is deleted once it's done"
  },
  "try": {
   "start": 123.81,
   "end": 126.94,
   "text": "Try it yourself at InboxZeroVR.com!"
  },
  "seven": {
   "start": 127.18,
   "end": 129.05,
   "text": "Play the demo in all seven levels,"
  },
  "agent": {
   "start": 129.14,
   "end": 131.49,
   "text": "or connect your agent and play your own inbox"
  },
  "hero": {
   "start": 131.77,
   "end": 134.01,
   "text": "Become a hero with inbox zero!"
  }
 },
