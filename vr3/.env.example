# Copy to .env.local (git ignores it) and fill in. Every key is optional: without them the site
# still serves the game and its demo inbox.

# Signs the mic's cookies (access code, agent round). Any long random string: `openssl rand -base64 32`
AUTH_SECRET=

# The ?access= code for judges: turns on the mic in the demo. Several: separate with commas.
ACCESS_CODE=

# Vercel AI Gateway: writes up what was said into the mic in an agent round. Without it the words
# are sent to the agent with only a greeting and a sign-off.
AI_GATEWAY_API_KEY=
# POLISH_MODEL=anthropic/claude-haiku-5.5
# FALLBACK_MODEL=google/gemini-3.8-flash

# Upstash Redis: where agent rounds wait to be played (lib/store.ts). Without it they are kept in the
# server's memory, which is fine for `npm run dev` but not on Vercel (instances don't share memory).
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Round two's mic: ElevenLabs Scribe (the game asks /api/scribe-token for a single-use token).
ELEVENLABS_API_KEY=

# Only if the site is reached through something that hides its real address (normally leave unset).
# PUBLIC_ORIGIN=https://example.com
