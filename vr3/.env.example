# Copy to .env.local (git ignores it) and fill in. Every key is optional: without them the site
# still serves the game and its demo inbox.

# Signs the session and access cookies. Any long random string: `openssl rand -base64 32`
AUTH_SECRET=

# The ?access= code that shows Connect Gmail (for you and for judges). Several: separate with commas.
ACCESS_CODE=

# Google OAuth client (Google Cloud console → Google Auth Platform → Clients → Web application).
# Authorized redirect URIs: http://localhost:3000/api/auth/callback, http://localhost:5183/api/auth/callback,
# and https://<your domain>/api/auth/callback. Audience: Testing, with each Google account added as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel AI Gateway. Without it, emails are sorted by rules and replies are stock ones.
AI_GATEWAY_API_KEY=
# Models (AI Gateway names). These are the defaults.
# SORT_MODEL=anthropic/claude-haiku-5.5
# REPLY_MODEL=anthropic/claude-sonnet-5.5
# FALLBACK_MODEL=google/gemini-3.8-flash

# Round two's mic: ElevenLabs Scribe (the game asks /api/scribe-token for a single-use token).
ELEVENLABS_API_KEY=

# Only if the site is reached through something that hides its real address (normally leave unset).
# PUBLIC_ORIGIN=https://example.com

# Allows POST /api/seed (fills the signed-in Gmail with the demo inbox). Only for a demo account.
# ALLOW_SEED=1

# A pretend Gmail made of the demo emails: anyone with the invite is "signed in", and archiving and
# drafts are only logged. For trying the live path (and the models) before Google is set up. Never in production.
# MOCK_GMAIL=1
