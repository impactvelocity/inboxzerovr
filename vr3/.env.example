# Copy to .env.local (git ignores it) and fill in. Every key is optional: without them the site
# still serves the game and its demo inbox.

# Signs the mic's cookies (access code, agent round). Any long random string: `openssl rand -base64 32`
AUTH_SECRET=

# The ?access= code for judges: turns on the mic in the demo. Several: separate with commas.
ACCESS_CODE=

# Vercel AI Gateway: the mic's speech-to-text (below). Nothing else on the server uses a model: what is said into
# the mic goes to the agent as it was heard (2026-11-15).
AI_GATEWAY_API_KEY=

# Upstash Redis: where agent rounds wait to be played (lib/store.ts). Without it they are kept in the
# server's memory, which is fine for `npm run dev` but not on Vercel (instances don't share memory).
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Round two's mic is ElevenLabs Scribe v2 realtime through the AI Gateway too: the game asks /api/scribe-token for a
# short-lived client secret, which only a real AI_GATEWAY_API_KEY can mint (the OIDC token is refused). MIC_MODEL changes it.
# MIC_MODEL=elevenlabs/scribe-v2-realtime
# Who gets the real mic: 1, everyone; 0, only a browser with an ?access= code or an agent round (anyone else: no mic button,
# round two is the demo recording). Unset: everyone in development, invite only on the site.
# SCRIBE_PUBLIC=1

# The address in every link an agent is given (play_url, Open in VR, the guide). Unset: https://www.inboxzerovr.com,
# even on a dev server (the site and dev share Upstash, so local rounds play there). Set it to http://localhost:5183
# to have agents send players to your local game instead.
# PUBLIC_ORIGIN=http://localhost:5183
