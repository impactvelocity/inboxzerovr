{
  "name": "inboxzero-vr3-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:all": "node scripts/dev-all.mjs",
    "build:game": "npm --prefix play run build && node scripts/copy-game.mjs",
    "build": "npm run build:game && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "bake": "tsx --env-file-if-exists=.env.local scripts/bake-demo.ts"
  },
  "dependencies": {
    "ai": "^7.0.170",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
